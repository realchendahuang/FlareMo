{
  "name": "@flaremo/site",
  "private": true,
  "version": "0.9.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "node .output/server/index.mjs",
    "check": "tsc -b --pretty false",
    "format": "prettier --write \"**/*.{ts,tsx,css,md}\"",
    "preview": "vite preview",
    "deploy": "vite build && wrangler deploy --config ./wrangler.jsonc",
    "deploy:dry-run": "vite build && wrangler deploy --config ./wrangler.jsonc --dry-run --outdir=dist"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.9",
    "@tailwindcss/vite": "^4",
    "@tanstack/react-router": "^1.170.0",
    "@tanstack/react-start": "^1.168.0",
    "@tanstack/react-start-client": "^1.168.0",
    "@tanstack/react-start-server": "^1.167.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.21.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.0.0",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "typescript": "^5.9.3",
    "vite": "^8",
    "wrangler": "^4.125.0"
  }
}