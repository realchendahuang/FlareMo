    "@flaremo/domain": "workspace:*",
    "@flaremo/memos": "workspace:*",
    "@hono/zod-validator": "^0.7.6",
    "better-auth": "1.6.25",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.10.7",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260708.1",
    "@connectrpc/connect": "2.1.1",
    "@connectrpc/connect-web": "2.1.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0",
    "wrangler": "^4.114.0"
