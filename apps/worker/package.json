{
  "name": "@flaremo/worker",
  "version": "0.4.3",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "wrangler dev --config ../../wrangler.jsonc --local",
    "deploy": "wrangler deploy --config ../../wrangler.jsonc",
    "build": "tsc -b",
